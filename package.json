{
  "name": "memo-by-heart",
  "productName": "Memo",
  "version": "1.0.0",
  "description": "Memorize poems, speeches, scripture, lines and more by heart.",
  "main": "main.js",
  "author": "OrangeBubly",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . Memo --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=^/dist --ignore=^/.github --ignore=^/build --icon=build/icon.ico",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "icons": "node build/make-icons.js",
    "dist:win:linux": "electron-builder --win dir && makensis -DVERSION=1.0.0 build/memo-installer.nsi && electron-builder --win portable --prepackaged dist/win-unpacked --publish never"
  },
  "build": {
    "appId": "com.orangebubly.memo",
    "productName": "Memo",
    "copyright": "Copyright \u00a9 2026 OrangeBubly",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memo",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Memo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Memo-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Memo-Portable-${version}.exe"
    },
    "afterPack": "build/after-pack.js"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "^1.7.2"
  }
}
